{
  "bucket": "airquality-data-store-develop",
  "prefix": "aqs/transformed/hourly/ozone/",
  "vector": true,
  "chunk_size": 1,
  "worker_concurrency": 1,
  "collection": "ozone_hourly_bt_test_slesa2",
  "filename_regex": ".*hourly_44201_202[1-4]\\.csv$",
  "extra_flags": [
    "-append",
    "-nln",
    "ozone_hourly_bt_test_slesa2",
    "-oo",
    "X_POSSIBLE_NAMES=longitude",
    "-oo",
    "Y_POSSIBLE_NAMES=latitude",
    "-oo",
    "AUTODETECT_TYPE=YES",
    "-oo",
    "EMPTY_STRING_AS_NULL=YES",
    "--config",
    "PG_USE_COPY",
    "YES",
    "--debug",
    "on"
  ],
  "table_config": {
    "schema": "public",
    "indexes": [
      {"columns": ["datetime_gmt_utc"], "method": "btree", "concurrently": true},
      {"columns": ["state_code", "county_code", "site_num", "poc", "datetime_gmt_utc"], "method": "btree", "concurrently": true}
    ],
    "analyze": true
  },
  "source_projection": "EPSG:4326",
  "target_projection": "EPSG:4326",
  "invalidate_cloudfront": true
}